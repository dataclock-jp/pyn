system pair "部分的にもつれた対:部分の記述にだけ時間が流れる":
  ppyn: 0.2
  """
  部分的にもつれた2個の量子ビット(重みは 0.75 と 0.25)。全体は純粋な状態なので、全体の記述には時間の流れが無い。

  アリスの側だけ、ボブの側だけの記述には流れがあり、振動数は log(0.75 / 0.25) = 1.0986 になる。流れの速さは、相手とのもつれ方で決まる。
  """

  projector eA0 "アリスの Z 方向で上向き":
    party: A

  projector eA1 "アリスの X 方向で上向き":
    party: A

  projector eB0 "ボブの Z 方向で上向き":
    party: B

  projector eB1 "ボブの X 方向で上向き":
    party: B

  description whole "全体の記述(純粋なので、流れを定義できない)":
    frequency: none

  description dA "アリスの側だけの記述":
    frequency: 1.09861228867
    parties: [A]

  description dB "ボブの側だけの記述":
    frequency: 1.09861228867
    parties: [B]

  term t-001 "ω(eA0)":
    factors: [eA0]
    value: 0.75

  term t-002 "ω(eA1)":
