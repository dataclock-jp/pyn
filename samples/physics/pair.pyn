  quantity q-two-time "アリスの時間で 0.5 だけ離れた、同じ射影どうしの相関":
    expect: [0.463221746577, -0.0652619467735]
    expr: "eA1 * flow(dA, eA1, 0.5)"
    tol: 0.000001

  quantity q-still "流れのもとで ω は変わらない":
    expect: 0
    expr: "flow(dA, eA1, 0.7) - eA1"
    tol: 0.000001

  quantity q-fixed "生成子と可換な射影は、流れで動かない":
    expect: 0
