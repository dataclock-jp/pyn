spec learning "AI の実験記憶":
  version: 1
  """
  AI の経験を「観察 → 仮説 → 検証 → 修正」として残す実験例。専用の構文は無く、すべて既存のノードと属性で書いている。出典は `cites` で `source` ノードを指す(relation の `source` 属性は辺の始点で、出典とは別もの)。
  """

  source trial-001 "試行 001 の実験ログ":
    reliability: 0.9

  source trial-002 "試行 002 の実験ログ":
    reliability: 0.9

  observation obs-01 "方法Aは条件Xで失敗":
    cites: trial-001
    confidence: 1.0
    occurred_at: "2026-11-14T09:00:00+09:00"
    recorded_at: "2026-11-14T09:01:00+09:00"
    """
    条件Xで方法Aを試したところ、指定した成功基準を満たさなかった。
    """

  hypothesis hyp-01 "条件Xでは方法Bが有効かもしれない":
    confidence: 0.4
    evidence_id: obs-01
    status: tentative
    """
    @obs-01 は方法Aの限界を示すが、方法Bの成功までは証明しない。
    """

  observation obs-02 "方法Bで成功基準を満たした":
    cites: trial-002
    confidence: 0.9
    occurred_at: "2026-11-14T10:00:00+09:00"
    """
    条件Xで方法Bを3回試し、すべて成功基準を満たした。
    """

  hypothesis hyp-02 "条件Xでは方法Bが有効である可能性が高い":
    confidence: 0.8
    evidence_id: obs-02
    status: tentative
    """
    @obs-02 に基づく暫定的な判断。未知の条件への一般化は保留する。
    """

  relation rel-01 "失敗観察から仮説へ":
    kind: derived_from
    source: hyp-01
    target: obs-01

  relation rel-02 "成功観察が新仮説を支持":
    confidence: 0.9
    evidence_id: obs-02
    kind: supports
    source: obs-02
    target: hyp-02

  relation rel-03 "新仮説が旧仮説を更新":
    kind: supersedes
    recorded_at: "2026-11-14T10:05:00+09:00"
    source: hyp-02
    target: hyp-01
